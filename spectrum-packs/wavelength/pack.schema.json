{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wavelength spectrum pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "game",
    "packId",
    "language",
    "title",
    "spectrums"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "game": { "const": "wavelength" },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9-]+$"
    },
    "language": { "enum": ["en", "de"] },
    "title": { "$ref": "#/$defs/text100" },
    "development": { "type": "boolean" },
    "spectrums": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "left", "right", "category", "tone", "difficulty"],
        "properties": {
          "id": { "$ref": "#/$defs/text100" },
          "left": { "$ref": "#/$defs/endpoint" },
          "right": { "$ref": "#/$defs/endpoint" },
          "category": {
            "enum": [
              "everyday",
              "social",
              "culture",
              "emotions",
              "relationships",
              "practical",
              "philosophical",
              "absurd"
            ]
          },
          "tone": { "enum": ["light", "thoughtful", "silly"] },
          "difficulty": { "enum": ["easy", "medium", "challenging"] }
        }
      }
    }
  },
  "$defs": {
    "text100": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!\\s)(?!.*[<>\\u0000-\\u001f]).*\\S$"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?!\\s)(?!.*[<>\\u0000-\\u001f]).*\\S$"
    }
  }
}
