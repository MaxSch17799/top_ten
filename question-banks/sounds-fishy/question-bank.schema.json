{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sounds Fishy private question bank",
  "type": "object",
  "required": ["schemaVersion", "bankId", "language", "title", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bankId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9-]+$" },
    "language": { "type": "string", "maxLength": 30, "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "development": { "type": "boolean" },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "answer", "acceptedAnswers", "category", "answerType", "difficulty", "explanation", "sources", "verificationNotes"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "question": { "type": "string", "minLength": 1, "maxLength": 600 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 240 },
          "acceptedAnswers": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
          "category": { "enum": ["animals", "nature", "history", "science", "geography", "food", "inventions", "everyday_life", "culture", "human_behavior", "extraordinary_events", "technology"] },
          "answerType": { "enum": ["person", "place", "animal", "object", "number", "date", "phrase", "other"] },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "verificationNotes": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sources": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "required": ["title", "publisher", "url", "accessed"], "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "publisher": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "accessed": { "type": "string", "format": "date" }
            } }
          }
        }
      }
    }
  }
}
