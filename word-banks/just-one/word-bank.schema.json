{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-night:just-one:word-bank:v1",
  "title": "Just One word bank v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "language", "version", "cards"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "version": { "type": "integer", "minimum": 1 },
    "development": { "type": "boolean", "default": false },
    "description": { "type": "string" },
    "theme": { "type": "string" },
    "difficulty": { "type": "string" },
    "cards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "words"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "words": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^\\S(?:.*\\S)?$" } }
        }
      }
    }
  }
}
